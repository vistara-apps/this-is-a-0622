# SampleFlow Environment Variables
# Copy this file to .env and fill in your actual values

# API Configuration
VITE_API_BASE_URL=http://localhost:3000/api

# Supabase Configuration (Required)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI Configuration (Required for sample identification)
VITE_OPENAI_API_KEY=your_openai_api_key

# Pinata IPFS Configuration (Required for document storage)
VITE_PINATA_API_KEY=your_pinata_api_key
VITE_PINATA_SECRET_KEY=your_pinata_secret_key
VITE_PINATA_JWT=your_pinata_jwt_token

# Airstack Configuration (Optional - for blockchain data)
VITE_AIRSTACK_API_KEY=your_airstack_api_key

# Stripe Configuration (Required for subscriptions)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
VITE_STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
VITE_STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (Create these in your Stripe dashboard)
VITE_STRIPE_PRO_PRICE_ID=price_your_pro_tier_price_id
VITE_STRIPE_ARTIST_PRICE_ID=price_your_artist_tier_price_id

# Development/Production Mode
NODE_ENV=development
